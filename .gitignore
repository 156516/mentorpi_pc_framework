# build 产物（不提交）
build/
install/
log/

# IDE — 提交项目级 .vscode/ 配置（tasks / launch / settings / extensions），
# 个人状态（workspace.json / argv.json 等）依然忽略
.idea/
.vscode/argv.json
.vscode/workspace.json

# 但保留以下项目级配置（! 反向）
!/.vscode/
!/services/gui/.vscode/

# 临时
*.pyc
__pycache__/

# bin/obj（C#）
bin/
obj/

# Docker
**/.dockerignore-tmp

# 镜像产物（不要提交大文件）
*.tar
*.tar.gz

# SLAM 地图（不提交 .pgm 二进制大文件；目录保留用于保存地图）
maps/*.pgm
maps/*.yaml
!maps/.gitkeep