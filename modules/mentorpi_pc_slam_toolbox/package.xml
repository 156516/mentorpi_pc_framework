<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mentorpi_pc_slam_toolbox</name>
  <version>0.1.0</version>
  <description>PC-side slam_toolbox mapper for MentorPi (consumes /scan_raw from Pi, publishes /map + TF)</description>
  <maintainer email="dev@home.local">dev</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>slam_toolbox</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
