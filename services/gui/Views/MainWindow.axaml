<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MentorpiPc.Gui.ViewModels"
        xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        x:Class="MentorpiPc.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MentorPi PC 控制台"
        Width="1100" Height="800">

  <Window.Resources>
    <!-- 把 ObjectConverters 暴露为 x:Static 资源，避免某些 XAML 解析器对默认 namespace 的支持不一致 -->
    <!-- 简化：直接用 ResourceInclude 或本地引用 -->
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12">
    <!-- 顶栏：连接状态 -->
    <Border Grid.Row="0" Background="#F0F0F0" Padding="8" CornerRadius="4">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="ROS:" />
        <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Bold" />
        <Button Content="连接" Command="{Binding ConnectCommand}" />
      </StackPanel>
    </Border>

    <!-- 中间：上半部分状态卡片，下半部分 /map -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,12,0,12">

      <!-- 上半：电池 / 速度 / IMU -->
      <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,8">

        <!-- 电池 -->
        <Border Grid.Column="0" Background="#FAFAFA" Padding="12" CornerRadius="4" Margin="0,0,4,0">
          <StackPanel Spacing="6">
            <TextBlock Text="电池" FontSize="14" Foreground="Gray" />
            <TextBlock Text="{Binding BatteryVoltage, StringFormat='{}{0:F2} V'}" FontSize="28" FontWeight="Bold" />
            <ProgressBar Value="{Binding BatteryPercentage}" Maximum="100" />
          </StackPanel>
        </Border>

        <!-- 速度 -->
        <Border Grid.Column="1" Background="#FAFAFA" Padding="12" CornerRadius="4" Margin="4,0">
          <StackPanel Spacing="6">
            <TextBlock Text="速度" FontSize="14" Foreground="Gray" />
            <TextBlock Text="{Binding LinearVel, StringFormat='v={0:F2} m/s'}" FontSize="20" />
            <TextBlock Text="{Binding AngularVel, StringFormat='w={0:F2} rad/s'}" FontSize="20" />
          </StackPanel>
        </Border>

        <!-- IMU -->
        <Border Grid.Column="2" Background="#FAFAFA" Padding="12" CornerRadius="4" Margin="4,0,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="IMU 姿态" FontSize="14" Foreground="Gray" />
            <TextBlock Text="{Binding ImuRoll, StringFormat='R={0:F0}°'}" FontSize="18" />
            <TextBlock Text="{Binding ImuPitch, StringFormat='P={0:F0}°'}" FontSize="18" />
            <TextBlock Text="{Binding ImuYaw, StringFormat='Y={0:F0}°'}" FontSize="18" />
          </StackPanel>
        </Border>

      </Grid>

      <!-- 下半：/map 实时图（叠加在导入的参考图上） -->
      <Border Grid.Row="1" Background="#FAFAFA" Padding="8" CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding MapInfo}"
                     FontSize="12"
                     Foreground="Gray"
                     Margin="0,0,0,6" />
          <Border Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" ClipToBounds="True">
            <!-- Grid 叠两层 Image：底层导入参考图（半透明），上层实时 /map -->
            <Grid>
              <Image Source="{Binding ImportedMapImage}"
                     Stretch="Uniform"
                     Opacity="0.5" />
              <Image Source="{Binding MapImage}" Stretch="Uniform" />
            </Grid>
          </Border>
        </DockPanel>
      </Border>

    </Grid>

    <!-- 地图控制按钮栏 -->
    <Border Grid.Row="2" Background="#F0F0F0" Padding="8" CornerRadius="4" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding MappingButtonText}" Click="OnToggleMappingClick" MinWidth="110" />
        <Button Content="💾 保存地图" Command="{Binding SaveMapCommand}" MinWidth="110" />
        <Button Content="📂 导入图片..." Click="OnImportMapClick" MinWidth="110" />
        <Button Content="⟳ 重启slam并加载"
                Command="{Binding RestartSlamWithMapCommand}"
                IsEnabled="{Binding ImportedMapName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                MinWidth="160"
                ToolTip.Tip="重启 slam_toolbox 并把导入的图作为定位起点（GUI 内待实现，请手动跑 bash mentorpi.sh load-map &lt;名&gt;）" />
        <TextBlock Text="{Binding MapControlStatus}" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
    </Border>

    <!-- 底栏：话题列表 -->
    <Border Grid.Row="3" Background="#F8F8F8" Padding="8" CornerRadius="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="订阅：" Foreground="Gray" />
        <TextBlock Text=" /odom   /imu   /ros_robot_controller/battery   /map" />
        <TextBlock Text="   服务：" Foreground="Gray" Margin="16,0,0,0" />
        <TextBlock Text=" /slam_toolbox/pause_new_measurements   /slam_toolbox/save_map" />
      </StackPanel>
    </Border>
  </Grid>
</Window>